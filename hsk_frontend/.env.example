# Biến môi trường frontend HSK (Next.js). Giá trị NEXT_PUBLIC_* được nhúng vào bundle lúc `next build`.
# Sao chép thành .env.local khi chạy local (file này đã được .gitignore). KHÔNG có giá trị mặc định trỏ tới hệ thống
# thật: để trống nghĩa là "chưa cấu hình" và giao diện hiển thị thông báo tương ứng.

# --- Authentication dùng chung (tên biến giống LMS_IELTS/frontend) ---
# Authentication_Frontend (SSO). Chưa đăng nhập => /login?redirect=<url hiện tại>.
NEXT_PUBLIC_AUTH_FRONTEND_URL=
# Authentication_Backend, ví dụ https://<host>/api/auth (dùng GET /users/me, POST /refresh, POST /logout).
NEXT_PUBLIC_AUTH_API_BASE_URL=

# --- Backend nghiệp vụ dùng chung với IELTS (LMS_IELTS/backend): MỖI service một base path (đường dẫn cùng origin, hoặc URL tuyệt đối) ---
# Trống => màn hình dùng service đó hiện "chưa tích hợp" (WAITING FOR BACKEND). Sau gateway Traefik của backend chung: /api/lms, /api/notification, /api/storage.
# repo-lms (Java): lớp học/học viên/giáo trình (chỉ đọc, proxy ERP), học phần, kho nội dung, chấm bài quản trị...
NEXT_PUBLIC_LMS_API_BASE_PATH=
# repo-storage (Go): tải tệp lên (presign/upload/confirm) và tải về.
NEXT_PUBLIC_STORAGE_API_BASE_PATH=
# repo-notification (Go): chuông + danh sách thông báo. Hợp đồng và khác biệt với HSK cũ: docs/api-requirements/notifications.md.
NEXT_PUBLIC_NOTIFICATION_API_BASE_PATH=
# Hợp đồng ĐỀ XUẤT cho các endpoint giảng viên (lớp được phân công, buổi học, bài nộp, chấm bài) mà backend chung CHƯA có (B0 OPEN).
# Để trống ở production cho tới khi backend triển khai; chỉ đặt khi có backend thật đáp ứng hợp đồng (docs/api-requirements/*.md).
NEXT_PUBLIC_QUIZ_API_BASE_PATH=
# Dịch vụ ticket (toast chào mừng ở sidebar, phân công công việc): backend chung chưa có.
NEXT_PUBLIC_TICKET_API_BASE_PATH=
# Các dịch vụ nghiệp vụ HSK theo hợp đồng ĐỀ XUẤT (giảng viên, thanh toán/sao kê/gói thành viên, khoá học trực tuyến, kho nội dung HSK, tài liệu, kho lưu trữ,
# phân tích hành vi, tổng quan quản trị) — backend chung chưa có. Để trống ở production cho tới khi backend triển khai (lib/api/hsk-client.ts).
NEXT_PUBLIC_HSK_API_BASE_PATH=
# Danh sách người dùng cho bộ chọn người nhận thông báo của Admin (chỉ ĐỌC; HSK cũ: `/id/admin/users`, dịch vụ định danh). Trống => bộ chọn hiện "chưa tích hợp".
NEXT_PUBLIC_ADMIN_USER_API_BASE_PATH=

# --- Màn Từ điển học viên (/vocabulary/:id): dịch vụ bên ngoài gọi THẲNG từ trình duyệt học viên; trống = tắt / dùng mặc định ---
# Khoá VoiceRSS để đọc to khi máy học viên không có giọng đọc tiếng Trung/Việt cài sẵn (HSK cũ ghi cứng khoá trong mã). Trống => chỉ dùng Web Speech.
NEXT_PUBLIC_TTS_VOICERSS_KEY=
# Nguồn dữ liệu nét chữ cho hanzi-writer (popup Luyện viết): các mẫu URL chứa "{char}", phân cách dấu phẩy, vd https://cdn.example.com/hanzi/{char}.json.
# Trống => hai nguồn jsdelivr như HSK cũ (hanzi-writer-data@2.0.1 và hanzi-writer-data-youyin).
NEXT_PUBLIC_HANZI_WRITER_DATA_URLS=
# Đặt `enabled` để hiện ảnh chữ triện tìm trên Wikimedia Commons khi từ chưa có ảnh (chỉ hiển thị, không lưu về hệ thống). Trống => tắt.
NEXT_PUBLIC_DICTIONARY_WIKIMEDIA_FALLBACK=

# --- Màn Khoá học học viên (/student/student-courses). Dữ liệu khoá lấy từ repo-lms (/hsk-courses) qua NEXT_PUBLIC_LMS_API_BASE_PATH. ---
# Nhãn ưu đãi trên banner "Tất cả khoá học" (HSK cũ ghi cứng "20%"), vd 20%. Trống => ẩn dòng ưu đãi (không hiện khuyến mãi không có thật).
NEXT_PUBLIC_STUDENT_COURSE_PROMO=
# Trang đăng ký/mở khoá khi học viên bấm "Mở khoá ngay!" (URL http(s) hoặc đường dẫn nội bộ "/..."). Trống => hộp thông báo "Đăng ký khóa học".
NEXT_PUBLIC_STUDENT_COURSE_UNLOCK_URL=

# --- Công tắc an toàn cho THAO TÁC GHI chưa có hợp đồng backend xác nhận. Mặc định trống = ĐÓNG (giao diện hiện "chưa tích hợp", không tạo request ghi). ---
# CHỈ đặt `enabled` sau khi người phụ trách backend xác nhận hợp đồng tương ứng (docs/api-requirements/*.md).
NEXT_PUBLIC_NOTIFICATION_CAMPAIGN_SEND=
NEXT_PUBLIC_WRITE_QUIZ_GRADING=
NEXT_PUBLIC_WRITE_TEACHER_NOTE=
NEXT_PUBLIC_WRITE_LESSON_DETAIL=
NEXT_PUBLIC_WRITE_TEACHER_MANAGEMENT=
NEXT_PUBLIC_WRITE_CONTENT=
NEXT_PUBLIC_WRITE_ONLINE_COURSE=
NEXT_PUBLIC_WRITE_STORAGE=
NEXT_PUBLIC_WRITE_WORK_TICKETS=
NEXT_PUBLIC_WRITE_MEMBERSHIP=

# --- Chỉ dùng khi `next dev` (phía server Next, KHÔNG có tiền tố NEXT_PUBLIC_): proxy cùng origin tới backend dev ---
# Cần NEXT_PUBLIC_<SVC>_API_BASE_PATH bắt đầu bằng "/" (vd /api/lms). Bị chặn khi build/chạy production.
LMS_API_PROXY_TARGET=
STORAGE_API_PROXY_TARGET=
HSK_API_PROXY_TARGET=
NOTIFICATION_API_PROXY_TARGET=
QUIZ_API_PROXY_TARGET=
TICKET_API_PROXY_TARGET=
ADMIN_USER_API_PROXY_TARGET=

# --- Chế độ XEM TRƯỚC CỤC BỘ với dữ liệu giả lập (MOCK / NOT INTEGRATED): KHÔNG đặt trong file .env*, chỉ do `npm run preview:local` đặt lúc build ---
# NEXT_PUBLIC_DEMO_MODE=1 chỉ hiện băng-rôn + mở công tắc ghi với máy chủ giả lập và chỉ hoạt động trên host loopback/mạng riêng; bản thật không đặt.
# Xem trước nhanh bằng `next dev` với máy chủ giả lập (npm run mock:server, cổng 3190):
#   NEXT_PUBLIC_AUTH_FRONTEND_URL=http://localhost:3190
#   NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:3190/api/auth
#   NEXT_PUBLIC_LMS_API_BASE_PATH=http://localhost:3190/api/lms
#   NEXT_PUBLIC_HSK_API_BASE_PATH=http://localhost:3190/api/hsk
#   NEXT_PUBLIC_QUIZ_API_BASE_PATH=http://localhost:3190/api/quiz
#   NEXT_PUBLIC_NOTIFICATION_API_BASE_PATH=http://localhost:3190/api/notification
#   NEXT_PUBLIC_TICKET_API_BASE_PATH=http://localhost:3190/api/tickets
#   NEXT_PUBLIC_ADMIN_USER_API_BASE_PATH=http://localhost:3190/api/admin/users
# next.config.ts từ chối build/chạy production với các giá trị localhost/.invalid/.test. Ngoại lệ HSK_ALLOW_MOCK_ENDPOINTS=1 chỉ đặt trên
# dòng lệnh (bị từ chối nếu có biến CI hoặc nếu nằm trong file .env*). Ngoài ra AuthInitializer từ chối chạy cấu hình mock khi trang
# được phục vụ từ host không phải loopback.
