        "explanation": "Leah nói workshop diễn ra vào Friday."
      },
      {
        "questionId": "01M4Q7K0CZHMNKX4DMVQHHXYXQ",
        "questionType": "MULTIPLE_CHOICE",
        "points": 1,
        "questionText": "<p>Where will the workshop be held?</p>",
        "options": [
          {
            "optionIndex": 0,
            "content": "At the museum",
            "correct": true
          },
          {
            "optionIndex": 1,
            "content": "At the college"
