      {
        "questionId": "01M4Q7K0CZER4ZK6ADA94A3K2F",
        "questionType": "MULTIPLE_CHOICE",
        "points": 1,
        "questionText": "<p>What do Leah and Joel decide should be the main aim of their session?</p>",
        "options": [
          {
            "optionIndex": 0,
            "content": "Support the class's current school topic"
